# 全部生产值均未配置；不要填Mock值。此文件不会被Node自动载入。
TCB_ENV_ID=
TCB_REGION=
# 必须精确为 https://<真实TCB_ENV_ID>.api.tcloudbasegateway.com
TCB_AUTH_ORIGIN=
# 服务端专用，逗号分隔真实CloudBase用户sub；不放Android/后台静态配置。
ADMIN_UIDS=
# 逗号分隔正式后台精确HTTPS origin，无路径；同源部署也需填。
ADMIN_ALLOWED_ORIGINS=
# 可选：本机审核的精确来源，例如 http://127.0.0.1:8791；只绑定回环地址。
ADMIN_LOCAL_ORIGIN=
# HTTP函数专用服务端API Key，只在云端受控配置，不放本地文件、App或静态后台。
# 此处为空；通过安全的内存流程注入CLOUDBASE_APIKEY，不将实际值写入此模板。
CLOUDBASE_APIKEY=
